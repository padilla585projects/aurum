# ═══════════════════════════════════════════════════════════
#  AURUM Backend — Variables de entorno
#  Copia este archivo a .env y rellena tus valores reales:
#    cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════

# ── Seguridad ────────────────────────────────────────────────
# Clave secreta que el frontend usa para autenticarse con el backend.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
AURUM_API_KEY=cambia_esto_por_una_clave_segura_32_chars

# Orígenes web autorizados a llamar al backend, separados por comas.
AURUM_ALLOWED_ORIGINS=https://aurum-7cm.pages.dev,http://localhost:5173

# ── Anthropic Claude ─────────────────────────────────────────
# Necesaria para el ciclo autónomo, el bot de Telegram y el intérprete /do.
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Trade Republic ───────────────────────────────────────────
# Teléfono (con prefijo internacional) y PIN de tu cuenta TR.
# Si no quieres autenticación automática al arrancar, déjalos vacíos
# y usa POST /auth/init desde el frontend.
TR_PHONE=+34612345678
TR_PIN=1234

# ── Telegram (opcional) ──────────────────────────────────────
# Para notificaciones y control desde el móvil.
# 1. Crea un bot con @BotFather → guarda el token
# 2. Envía /start a tu bot → usa @userinfobot para obtener tu chat_id
TELEGRAM_TOKEN=123456789:ABCdefGHI...
TELEGRAM_CHAT_ID=123456789
