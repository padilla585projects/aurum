# ═══════════════════════════════════════════════════════════
#  AURUM Backend — Variables de entorno
#  Copia este archivo a .env y rellena tus valores reales:
#    cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════

# ── Seguridad ────────────────────────────────────────────────
# Clave de arranque. Ya NO es la credencial de uso diario: solo sirve para
# emitir el primer token de propietario con POST /admin/tokens. En cuanto
# existe un token emitido deja de funcionar y puede borrarse.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
AURUM_API_KEY=cambia_esto_por_una_clave_segura_32_chars

# Clave maestra para cifrar las credenciales de broker de cada usuario
# (AES-256-GCM). Sin ella, guardar credenciales falla en vez de dejarlas en
# claro. Si se pierde, las ya guardadas no se podran descifrar.
# Genera una con:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AURUM_SECRET_KEY=

# Correo del propietario: identidad bajo la que corre el ciclo autonomo y
# duena de la sesion de broker creada con TR_PHONE/TR_PIN.
AURUM_OWNER_EMAIL=tu-correo@ejemplo.com

# Ruta del SQLite del backend (tokens, credenciales cifradas, ordenes, auditoria).
AURUM_DB_PATH=./aurum.db

# ── Limites de ejecucion ─────────────────────────────────────
# Interruptor maestro. Con false, AURUM analiza y propone pero NO manda ninguna
# orden al broker. Activalo solo tras probar el flujo de doble confirmacion.
AURUM_TRADING_ENABLED=false

# Importe maximo acumulado por usuario en 24 h, ademas del tope por orden.
AURUM_MAX_DAILY_EUR=1000

# Orígenes web autorizados a llamar al backend, separados por comas.
AURUM_ALLOWED_ORIGINS=https://aurum-7cm.pages.dev,http://localhost:5173

# ── Anthropic Claude ─────────────────────────────────────────
# Necesaria para el ciclo autónomo, el bot de Telegram y el intérprete /do.
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Trade Republic ───────────────────────────────────────────
# Credenciales del PROPIETARIO. Los demas usuarios guardan las suyas cifradas
# con PUT /broker/credentials y tienen su propia sesion independiente.
# Si no quieres autenticacion automatica al arrancar, dejalos vacios.
TR_PHONE=+34612345678
TR_PIN=1234

# ── Telegram (opcional) ──────────────────────────────────────
# Para notificaciones y control desde el móvil.
# 1. Crea un bot con @BotFather → guarda el token
# 2. Envía /start a tu bot → usa @userinfobot para obtener tu chat_id
TELEGRAM_TOKEN=123456789:ABCdefGHI...
TELEGRAM_CHAT_ID=123456789
