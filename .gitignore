node_modules/
dist/
.env
.env.local
# El proyecto de Android lo genera Capacitor, asi que no se versiona entero.
# Pero lo escrito a mano —el manifiesto y las clases propias— si: sin esto vive
# en un solo disco, y perderlo significa rehacerlo de memoria.
android/*
!android/app/
android/app/*
!android/app/src/
android/app/src/*
!android/app/src/main/
android/app/src/main/*
!android/app/src/main/AndroidManifest.xml
!android/app/src/main/java/
ios/
*.local
backend/__pycache__/
.dev.vars
.wrangler/
backend/aurum.db
backend/aurum.db-wal
backend/aurum.db-shm
__pycache__/
.pytest_cache/
coverage/
backend/.venv/
backend/aurum-backend.log

# La APK se copia aqui al desplegar; no se versiona.
public/descargas/*.apk
